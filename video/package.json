{
  "name": "mejores-amigos-reel",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture-panel.mjs",
    "sfx": "node scripts/gen-audio.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MejoresAmigosReel out/mejores-amigos-reel.mp4 --codec h264 --crf 16 --gl=angle",
    "music": "mkdir -p public/music && cp ../cancion.mp3 public/music/cancion.mp3 && ffmpeg -v error -y -i public/music/cancion.mp3 -af \"atrim=3.593:71.9,asetpts=PTS-STARTPTS,afade=t=in:d=0.12,afade=t=out:st=66.1:d=2.0,loudnorm=I=-14:TP=-1.5:LRA=9\" -ar 48000 public/music/song-reel.wav"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "^4.0.355",
    "@remotion/motion-blur": "^4.0.355",
    "@remotion/noise": "^4.0.355",
    "@remotion/paths": "^4.0.355",
    "@remotion/shapes": "^4.0.355",
    "@remotion/three": "^4.0.355",
    "@remotion/transitions": "^4.0.355",
    "@types/three": "^0.170.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-peeps": "^0.1.10",
    "remotion": "^4.0.355",
    "roughjs": "^4.6.6",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/react": "^19.3.0",
    "playwright-core": "1.56",
    "tesseract.js": "^5.1.1",
    "typescript": "5.8"
  }
}
